{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hitoiki-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "durable_objects": { "bindings": [{ "name": "QUOTA_LIMITER", "class_name": "QuotaLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaLimiter"] }],
  "vars": {
    "CLASSIFICATION_ENABLED": "true",
    "ANTHROPIC_MODEL": "claude-haiku-5-5",
    "INSTALL_DAILY_LIMIT": "100",
    "GLOBAL_DAILY_LIMIT": "1000",
    "INSTALL_MINUTE_LIMIT": "6",
    "GLOBAL_MINUTE_LIMIT": "30"
  }
}
